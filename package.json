{
  "name": "royalstream-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:frontend": "turbo run build --filter=@royalstream/frontend",
    "build:backend": "turbo run build --filter=@royalstream/backend-api",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^7.0.2",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}
